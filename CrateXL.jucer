  <EXPORTFORMATS>
    <ANDROIDSTUDIO targetFolder="Builds/Android" androidMinimumSDK="26" androidTargetSDK="35"
                   microphonePermissionNeeded="1" androidReadMediaAudioPermission="1"
                   androidBluetoothScanNeeded="1" androidBluetoothConnectNeeded="1"
                   androidEnableContentSharing="1" androidScreenOrientation="landscape"
                   smallIcon="aMuFbh" bigIcon="aMuFbh"
                   androidExtraCompilerFlags="-O2">
      <CONFIGURATIONS>
        <CONFIGURATION isDebug="1" name="Debug" androidArchitectures="arm64-v8a armeabi-v7a x86_64"/>
        <CONFIGURATION isDebug="0" name="Release" androidArchitectures="arm64-v8a armeabi-v7a" optimisation="3"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_audio_basics" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_devices" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_formats" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_processors" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_processors_headless" path="JUCE/modules"/>
