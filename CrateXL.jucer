<?xml version="1.0" encoding="UTF-8"?>

<!-- Crate XL for Android. Generate the Android Studio project with the Projucer
     (build-android.sh / build-android.bat do this for you), then build the APK. -->
<JUCERPROJECT name="Crate XL" projectType="guiapp" defines="JUCE_WEB_BROWSER=0&#10;JUCE_USE_CURL=0&#10;JUCE_DISPLAY_SPLASH_SCREEN=0&#10;JUCE_MODAL_LOOPS_PERMITTED=0"
